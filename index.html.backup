  <!-- Script: comprimir/expandir secciones (solo móvil) -->
  <script>
  (function(){
    const mq = window.matchMedia('(max-width:900px)');
    let active = false;

    function setup(){
      document.querySelectorAll('main section').forEach(sec=>{
        if(sec.dataset.collapseInit) return;
        const heading = sec.querySelector('h1,h2,h3,h4');
        if(!heading) return;

        // crear botón (visible solo por CSS en móvil)
        const btn = document.createElement('button');
        btn.className = 'collapse-btn';
        btn.type = 'button';
        btn.setAttribute('aria-expanded','true');
        btn.title = 'Comprimir/Expandir sección';
        btn.textContent = 'Comprimir';

        btn.addEventListener('click', ()=>{
          const isCollapsed = sec.classList.toggle('collapsed');
          btn.setAttribute('aria-expanded', String(!isCollapsed));
          btn.textContent = isCollapsed ? 'Mostrar' : 'Comprimir';

          if(isCollapsed){
            // calcular altura visible hasta el pie del heading (relative al section)
            const secRect = sec.getBoundingClientRect();
            const headRect = heading.getBoundingClientRect();
            const visible = Math.max( (headRect.bottom - secRect.top) + 8, 40 );
            sec.style.maxHeight = visible + 'px';
            sec.style.overflow = 'hidden';
            heading.scrollIntoView({behavior:'smooth', block:'nearest'});
          } else {
            // restaurar
            sec.style.maxHeight = '';
            sec.style.overflow = '';
            setTimeout(()=> heading.scrollIntoView({behavior:'smooth', block:'start'}), 120);
          }
        });

        sec.appendChild(btn);
        sec.dataset.collapseInit = '1';
      });
    }

    function teardown(){
      document.querySelectorAll('main section').forEach(sec=>{
        if(!sec.dataset.collapseInit) return;
        sec.classList.remove('collapsed');
        sec.style.maxHeight = '';
        sec.style.overflow = '';
        const btn = sec.querySelector('.collapse-btn');
        if(btn) btn.remove();
        delete sec.dataset.collapseInit;
      });
    }

    function handleChange(e){
      if(e.matches) { setup(); active = true; }
      else if(active) { teardown(); active = false; }
    }

    if(mq.addEventListener) mq.addEventListener('change', handleChange);
    else if(mq.addListener) mq.addListener(handleChange);

    if(mq.matches) setup();
  })();
  </script>
