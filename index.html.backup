        <img src="Otras%20Fotos/Imagen%20de%20WhatsApp%202025-10-12%20a%20las%2023.56.00_cebef793.jpg" alt="Carousel 8" class="carousel-img" loading="lazy" />
      </div>
      <div class="container mission-vision-grid">
        <div class="card mission-card">
