<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manada Audiovisual | Creamos historias</title>

  <meta name="description" content="Manada Audiovisual — producción audiovisual: documentales, comerciales, eventos y postproducción.">
  <meta name="keywords" content="producción audiovisual, documentales, comerciales, eventos, postproducción, Paraguay">
  <meta property="og:title" content="Manada Audiovisual">
  <meta property="og:description" content="Creamos historias que conectan: documentales, comerciales, eventos y más.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="/assets/og-image.jpg">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
<link rel="icon" href="/logo-192.png" sizes="192x192" type="image/png"> <!-- opcional -->
<link rel="apple-touch-icon" href="/logo-192.png"> <!-- opcional para iOS -->

  <link rel="stylesheet" href="styles.css" />

  <!-- Ajustes para botón de comprimir/expandir: solo estilos móviles -->
  <style>
    .section { position: relative; }

    /* Por defecto no afecta layout en escritorio */
    .collapse-btn{ display: none; }
    .collapse-all-btn{ display: none; }

    @media (max-width: 900px) {
      .collapse-btn{
        position: absolute;
        top: 8px;
        right: 8px;
        background: rgba(0,0,0,0.6);
        color: #fff;
        border: none;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .collapse-all-btn{
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(38, 156, 207, 0.2);
        border: 1px solid rgba(38, 156, 207, 0.4);
        color: #fff;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        transition: all 200ms ease;
        margin-right: 10px;
      }

      .collapse-all-btn:hover{
        background: rgba(38, 156, 207, 0.35);
        border-color: rgba(38, 156, 207, 0.6);
      }

      .collapse-all-icon{
        display: inline-block;
        transition: transform 250ms ease;
      }

      .collapse-all-btn.all-collapsed .collapse-all-icon{
        transform: rotate(180deg);
      }

      .collapse-all-text{
        font-weight: 500;
      }

      .section-header{ display:block; }

      .section-body{
        transition: max-height 320ms ease, opacity 300ms ease;
        overflow: hidden;
        max-height: 20000px;
        opacity: 1;
      }

      .section.collapsed .section-body{
        max-height: 0 !important;
        opacity: 0;
        pointer-events: none;
      }
    }
  </style>
</head>
<body>
  <header class="main-header">
    <div class="container nav-container">
      <div class="logo-wrapper">
        <img src="Fotos%20para%20la%20pagina/SOLAMENTE%20LOGO.png" alt="Logo Manada Audiovisual" class="logo-img" loading="lazy" />
        <div class="logo">
          <span class="logo-main">Manada</span>
          <span class="logo-sub">Audiovisual</span>
        </div>
      </div>

      <button class="nav-toggle" aria-label="Abrir menú">
        <span class="nav-toggle-line"></span>
        <span class="nav-toggle-line"></span>
      </button>

      <button class="collapse-all-btn" aria-label="Comprimir todas las secciones" title="Comprimir/Expandir todas las secciones">
        <span class="collapse-all-icon">▼</span>
        <span class="collapse-all-text">Comprimir todo</span>
      </button>

      <nav class="main-nav">
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#lo-mas-reciente">Lo más reciente</a></li>
          <li><a href="#proyecto">Crear proyecto</a></li>
          <li><a href="#produccion">Producción</a></li>
          <li><a href="#casting">Casting</a></li>
          <li><a href="#aliados">Aliados</a></li>
          <li><a href="#nosotros">Nosotros</a></li>
          <li><a href="#redes">Redes</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO / INICIO -->
    <section id="inicio" class="hero">
      <div class="container hero-grid">
        <div class="hero-text">
          <p class="hero-kicker">Bienvenido a</p>
          <h1>
            Manada Audiovisual<br />
            <span>Creamos historias que conectan</span>
          </h1>
          <p class="hero-description">
            Somos Manada Audiovisual. Creamos historias que conectan, emocionan
            y dejan huella. Transformamos ideas en contenido profesional para
            marcas, empresas y proyectos que buscan impacto real.
          </p>

          <div class="hero-cta-group">
            <button class="btn-primary" data-scroll-target="#redes">
              👉 Sumarte a la Manada
            </button>
            <p class="hero-note">
              Proyectos, marcas, eventos y productos con ganas de crecer: este es su lugar.
            </p>
          </div>
        </div>

        <div class="hero-card">
          <h2>Lo que hacemos</h2>
          <ul class="services-list">
            <li>Producción y cobertura de eventos</li>
            <li>Contenido digital para redes sociales</li>
            <li>Spots publicitarios y corporativos</li>
            <li>Aftermovies, videoclips y documentales</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- MISIÓN / VISIÓN -->
    <section id="nosotros-mision-vision" class="section section-alt mission-vision-section">
      <div class="mission-vision-carousel">
        <img src="Otras%20Fotos/DSC_4101.jpg" alt="Carousel 1" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/DSC_4105.jpg" alt="Carousel 2" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/DSC_4111.jpg" alt="Carousel 3" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/DSC_4127.jpg" alt="Carousel 4" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/FICCION%20-%20SDB%201.png" alt="Carousel 5" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/DSC_4282.jpg" alt="Carousel 6" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/max4.jpg" alt="Carousel 7" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/Imagen%20de%20WhatsApp%202025-10-12%20a%20las%2023.56.00_cebef793.jpg" alt="Carousel 8" class="carousel-img" loading="lazy" />

        <img src="Otras%20Fotos/DSC_4101.jpg" alt="Carousel 1" class="carousel-img" loading="lazy" />
