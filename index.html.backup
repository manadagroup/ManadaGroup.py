        <img src="Otras%20Fotos/DSC_4111.jpg" alt="Carousel 3" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/DSC_4127.jpg" alt="Carousel 4" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/FICCION%20-%20SDB%201.png" alt="Carousel 5" class="carousel-img" loading="lazy" />
        <img src="Otras%20Fotos/FICCION%20-%20SDB%202.png" alt="Carousel 6" class="carousel-img" loading="lazy" />
